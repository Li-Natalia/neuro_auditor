# ===== Application =====
APP_NAME=Нейроаудитор
APP_ENV=development
APP_DEBUG=true
APP_API_PREFIX=/api
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:8000/api

# ===== Database (PostgreSQL) =====
POSTGRES_USER=finauditor
POSTGRES_PASSWORD=finauditor
POSTGRES_DB=finauditor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finauditor:finauditor@postgres:5432/finauditor
DATABASE_URL_SYNC=postgresql://finauditor:finauditor@postgres:5432/finauditor

# ===== Redis / Celery =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== Security (JWT) =====
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== OAuth2 (optional) =====
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# ===== File storage =====
UPLOAD_DIR=./media/uploads
REPORT_DIR=./media/reports
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=xlsx,xls

# ===== AI / NLP (optional, heavy) =====
# Path to a local model or HF model id for the chatbot pipeline
CHATBOT_MODEL_ID=distilbert-base-uncased
SPACY_MODEL=en_core_web_sm
OPENAI_API_KEY=

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
