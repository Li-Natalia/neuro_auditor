# ===== Application =====
APP_NAME=Нейроаудитор
APP_ENV=development
APP_DEBUG=true
APP_API_PREFIX=/api
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:8000/api

# ===== Database (PostgreSQL) =====
POSTGRES_USER=finauditor
POSTGRES_PASSWORD=finauditor
POSTGRES_DB=finauditor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finauditor:finauditor@postgres:5432/finauditor
DATABASE_URL_SYNC=postgresql://finauditor:finauditor@postgres:5432/finauditor

# ===== Redis / Celery =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== Security (JWT) =====
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== OAuth2 (optional) =====
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# ===== File storage =====
UPLOAD_DIR=./media/uploads
REPORT_DIR=./media/reports
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=xlsx,xls

# ===== AI / NLP (optional, heavy — local pipeline) =====
# Path to a local model or HF model id for the chatbot pipeline
CHATBOT_MODEL_ID=distilbert-base-uncased
SPACY_MODEL=en_core_web_sm

# ===== LLM chatbot =====
# Provider: auto (Yandex if configured, else OpenAI, else rule-based) | yandex | openai | rule
AI_PROVIDER=auto
# --- Yandex Cloud (YandexGPT via OpenAI-compatible API) ---
AI_BASE_URL=https://llm.api.cloud.yandex.net/v1
AI_YC_API_KEY=
AI_YC_FOLDER_ID=
AI_MODEL=yandexgpt/latest
# --- OpenAI (fallback / alternative) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# --- generation params ---
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
