# Backend-specific environment (copy to .env)
APP_NAME=Нейроаудитор
APP_ENV=development
APP_DEBUG=true
APP_API_PREFIX=/api

# When running backend locally (not in docker), use localhost for db/redis
POSTGRES_USER=finauditor
POSTGRES_PASSWORD=finauditor
POSTGRES_DB=finauditor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finauditor:finauditor@localhost:5432/finauditor
DATABASE_URL_SYNC=postgresql://finauditor:finauditor@localhost:5432/finauditor

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

UPLOAD_DIR=./media/uploads
REPORT_DIR=./media/reports
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=xlsx,xls

CHATBOT_MODEL_ID=distilbert-base-uncased
SPACY_MODEL=en_core_web_sm

# ===== LLM chatbot =====
# Provider: auto (Yandex → OpenAI → «нейросеть недоступна») | yandex | openai
AI_PROVIDER=auto
# --- Yandex Cloud (YandexGPT via OpenAI-compatible API) ---
AI_BASE_URL=https://llm.api.cloud.yandex.net/v1
AI_YC_API_KEY=
AI_YC_FOLDER_ID=
AI_MODEL=yandexgpt/latest
# --- OpenAI (fallback / alternative) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# --- generation params ---
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
