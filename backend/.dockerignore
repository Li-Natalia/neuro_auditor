# Keep the build context small and avoid baking host/dev artefacts & secrets.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets / local env — never bake into the image
.env
.env.*
!.env.example

# Local data / uploads / logs
media/
*.log

# VCS / editor
.git/
.gitignore
.idea/
.vscode/
